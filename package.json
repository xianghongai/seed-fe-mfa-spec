{
  "name": "@seed-fe/mfa-spec",
  "version": "0.1.0",
  "description": "Configuration protocols of the MFA (seed-fe-mfa) micro-frontend workspace: project metadata (meta.json), the preset menu (menu.config.json) and sitemaps (sitemap.json). Pure data logic for Node.js and browsers, independent of any CLI or editor.",
  "keywords": [
    "menu",
    "meta.json",
    "mfa",
    "micro-frontend",
    "seed-fe",
    "sitemap"
  ],
  "homepage": "https://github.com/xianghongai/seed-fe-mfa-spec#readme",
  "bugs": {
    "url": "https://github.com/xianghongai/seed-fe-mfa-spec/issues"
  },
  "license": "MIT",
  "author": "Nicholas Hsiang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xianghongai/seed-fe-mfa-spec.git"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "changeset": "changeset",
    "check-types": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src test",
    "prepack": "pnpm run check-types && pnpm run lint && pnpm run test && pnpm run build",
    "release": "changeset publish",
    "test": "vitest run"
  },
  "dependencies": {
    "js-yaml": "^5.4.2",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.25.0"
}
